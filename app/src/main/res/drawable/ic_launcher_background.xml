            <gradient
                android:centerX="54"
                android:centerY="38"
                android:gradientRadius="76"
                android:type="radial">
                <item
                    android:color="#FF213174"
                    android:offset="0.0" />
                <item
                    android:color="#FF111A45"
                    android:offset="0.5" />
                <item
                    android:color="#FF04050E"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Starfield. -->
